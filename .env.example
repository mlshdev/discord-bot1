# Required — bot token from https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-bot-token
# Required — the only server the bot listens to
GUILD_ID=000000000000000000
# Required — the only text channel slash commands run in, and where tracks are announced (may be a voice channel's chat)
TEXT_CHANNEL_ID=000000000000000000
# Required — the voice channel the bot plays in
VOICE_CHANNEL_ID=000000000000000000
# Required — role allowed to use /ff, /mn and /won
DJ_ROLE_ID=000000000000000000

# Optional
MAX_QUEUE_SIZE=100
IDLE_DISCONNECT_SECONDS=300
# Opus bitrate sent to Discord after loudness normalisation and volume
AUDIO_BITRATE_KBPS=128
HEALTH_PORT=8080
APP_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
# Required file, not a variable: a signed-in YouTube cookies.txt at discord-bot1/config/cookies.txt.
# Only set this to read it from another path inside the container.
# YTDLP_COOKIES_FILE=/config/cookies.txt
