# Required — bot token from https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-bot-token
# Required — the only server the bot listens to
GUILD_ID=000000000000000000
# Required — the only text channel slash commands run in, and where tracks are announced (may be a voice channel's chat)
TEXT_CHANNEL_ID=000000000000000000
# Optional — limit playback to these voice channels, comma-separated: 111111111111111111,222222222222222222
# If omitted, /add joins the requester's voice channel (the requester must be in voice).
# With one ID, /add can join it even if the requester is not in voice.
# VOICE_CHANNEL_ID=000000000000000000
# Required — role(s) allowed to use /ff, /mn, /won and /vol, comma-separated; any one of them is enough
DJ_ROLE_ID=000000000000000000

# Optional
MAX_QUEUE_SIZE=100
IDLE_DISCONNECT_SECONDS=300
# Opus bitrate sent to Discord after loudness normalisation and volume
AUDIO_BITRATE_KBPS=128
HEALTH_PORT=8080
APP_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
# Required file, not a variable: a signed-in YouTube cookies.txt next to compose.yml,
# bind-mounted read-only to /config/cookies.txt. Only set this to use another path in the container.
# YTDLP_COOKIES_FILE=/config/cookies.txt
# Persistent bot state (the /vol level): state.json next to compose.yml, bind-mounted read-write
# STATE_FILE=/data/state.json
